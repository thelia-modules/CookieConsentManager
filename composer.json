{
    "name": "thelia/cookie-consent-manager-module",
    "description": "Consent management platform for Thelia 3: banner, consent registry, Google Consent Mode v2, published versions.",
    "type": "thelia-module",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "thelia/installer": "^1.6",
        "justinrainbow/json-schema": "^6.0",
        "symfony/http-client": "^7.4",
        "symfony/rate-limiter": "^7.4"
    },
    "conflict": {
        "thelia/core": "<3.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "~3.93.1"
    },
    "autoload": {
        "psr-4": {
            "CookieConsentManager\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CookieConsentManager\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "installer-name": "CookieConsentManager"
    }
}
