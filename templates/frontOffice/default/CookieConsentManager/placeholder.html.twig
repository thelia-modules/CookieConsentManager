{# ccm-templates:1 #}
{# ccm-templates/1 : placeholder of a service. In template mode (template_mode) it is the box the engine
   fills in for the fragments of the catalogue: {{key}}, {{name}}, {{controller}} and {{policyUrl}} are replaced and escaped by the engine.
   Phrasing content only: the placeholder replaces an iframe, which may sit in a paragraph.
   The box marker carries no key on purpose: with a key the compatibility layer intercepts the click and the
   engine can no longer move the focus to the unlocked content. #}
{% macro box(service, texts, template_mode, ccmStyle, preferencesUrl) %}
    <span class="ccm ccm-box"{% if template_mode %} data-ccm-placeholder-box{% endif %}{% if ccmStyle|trim %} style="{{ ccmStyle|trim }}"{% endif %}>
        <span class="ccm-box-title">{{ texts.blocked|replace({'%name%': service.name}) }}</span>
        {% if template_mode %}<span class="ccm-box-meta">{{ texts.purpose }}{{ texts.colon }}{{ '{{purposeLabel}}' }}</span>{% elseif service.purpose_label %}<span class="ccm-box-meta">{{ texts.purpose }}{{ texts.colon }}{{ service.purpose_label }}</span>{% endif %}
        <span class="ccm-box-meta">{{ texts.controller }}{{ texts.colon }}{{ service.controller|default(service.name) }}{% if service.policy_url %}<span data-ccm-if-policy> · <a class="ccm-link" href="{{ service.policy_url }}" target="_blank" rel="noopener noreferrer">{{ texts.policy }}</a></span>{% endif %}</span>
        <span class="ccm-actions ccm-js-only">
            <button type="button" class="ccm-btn ccm-btn--choice" data-ccm-action="service_allow" data-ccm-service="{{ service.key }}">{{ texts.allow_service|replace({'%name%': service.name}) }}</button>
            <button type="button" class="ccm-btn ccm-btn--outline" data-ccm-open>{{ texts.preferences_link }}</button>
        </span>
        <a class="ccm-btn ccm-btn--outline ccm-nojs-only" href="{{ preferencesUrl }}">{{ texts.preferences_link }}</a>
    </span>
{% endmacro %}
{% set ccmStyle %}{% if colors|default(false) %}--ccm-primary:{{ colors.primary }};--ccm-on-primary:{{ colors.on_primary }};--ccm-surface:{{ colors.surface }};--ccm-text:{{ colors.text }};{% endif %}{% endset %}
{% if template_mode|default(false) %}
    {{ _self.box(service, texts, true, ccmStyle, preferences_url|default('/ccm/preferences')) }}
{% else %}
    <span class="ccm ccm-placeholder" data-ccm-placeholder="{{ service.key }}"{% if src|default('') %} data-ccm-src="{{ src }}"{% endif %}{% for name, value in attributes|default({}) %} data-ccm-attr-{{ name }}="{{ value }}"{% endfor %}>
        {{ _self.box(service, texts, false, ccmStyle, preferences_url|default('/ccm/preferences')) }}
    </span>
{% endif %}
