{# ccm-templates:1 #}
{# ccm-templates/1 (Flexy) : link that reopens the preferences (Twig helper ccm_open_link). #}
{% if wrapper|default(false) %}<nav class="ccm ccm--flexy ccm-footer-link" aria-label="{{ label }}">{% endif %}<a class="ccm-open-link" href="{{ preferences_url|default('/ccm/preferences') }}" data-ccm-open>{{ label }}</a>{% if wrapper|default(false) %}</nav>{% endif %}
