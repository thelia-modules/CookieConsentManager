{
  "gtag": {
    "name": "Google Analytics 4",
    "purpose": "analytics",
    "kind": "script",
    "googleTag": true,
    "domains": [
      "www.googletagmanager.com",
      "www.google-analytics.com",
      "region1.google-analytics.com"
    ],
    "cookies": [
      "_ga",
      "_ga_*"
    ],
    "storage": [],
    "ignoreParams": [],
    "params": {
      "gtagUa": {
        "required": true,
        "label": {
          "fr": "Identifiant de mesure GA4",
          "en": "GA4 measurement ID"
        },
        "help": {
          "fr": "Identifiant de la forme G-XXXXXXXXXX, visible dans Google Analytics > Administration > Flux de données.",
          "en": "ID in the form G-XXXXXXXXXX, shown in Google Analytics > Admin > Data streams."
        },
        "pattern": "^(G|GT)-[A-Z0-9]+$"
      },
      "gtagCustomDomain": {
        "required": false,
        "label": {
          "fr": "Domaine de chargement personnalisé",
          "en": "Custom loading domain"
        },
        "help": {
          "fr": "Laisser vide pour www.googletagmanager.com. Sinon, domaine d'un serveur de balisage (sans https://).",
          "en": "Leave empty for www.googletagmanager.com. Otherwise the domain of a tagging server (without https://)."
        },
        "pattern": "^[A-Za-z0-9.-]+$"
      },
      "gtagCrossdomain": {
        "required": false,
        "label": {
          "fr": "Domaines de suivi inter-sites",
          "en": "Cross-domain tracking domains"
        },
        "help": {
          "fr": "Domaines à relier au suivi (laisser vide si un seul domaine).",
          "en": "Domains to link in tracking (leave empty for a single domain)."
        },
        "pattern": null
      }
    }
  },
  "googletagmanager": {
    "name": "Google Tag Manager",
    "purpose": "ads",
    "kind": "script",
    "googleTag": true,
    "domains": [
      "www.googletagmanager.com"
