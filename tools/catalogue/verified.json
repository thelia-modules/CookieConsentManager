          "en": "Container ID"
        },
        "help": {
          "fr": "Identifiant de la forme GTM-XXXXXXX, visible dans l'interface Google Tag Manager.",
          "en": "ID in the form GTM-XXXXXXX, shown in the Google Tag Manager interface."
        },
        "pattern": "^GTM-[A-Z0-9]+$"
      },
      "googletagmanagerCustomDomain": {
        "required": false,
        "label": {
          "fr": "Domaine de chargement personnalisé",
          "en": "Custom loading domain"
        },
        "help": {
          "fr": "Laisser vide pour www.googletagmanager.com. Sinon, domaine d'un serveur de balisage (sans https://).",
          "en": "Leave empty for www.googletagmanager.com. Otherwise the domain of a tagging server (without https://)."
        },
        "pattern": "^[A-Za-z0-9.-]+$"
      }
    }
  },
